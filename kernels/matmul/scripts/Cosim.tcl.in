# Vitis HLS synthesis + C/RTL co-simulation script for MatmulKernel.
# Generated by CMake.
#
# Runs C synthesis and RTL co-simulation in a SINGLE component run, so the
# component's run summary (open with `vitis -a <component>`) covers BOTH the
# synthesis report and the cosim report — measured latency / II.
#
# Sequencing multiple HLS steps needs no special mechanism: listing
# csynth_design then cosim_design in one TCL and running it with a single
# `vitis-run --mode hls --tcl` invocation executes them in order on the same
# component (matches Xilinx's run_vitis_unified.tcl example).
#
# Variables substituted by CMake configure_file (@ONLY):
#   MM_COSIM_COMPONENT   — HLS component directory name
#   MM_BOARD_OPTION      — set_part command (includes -board if present)
#   MM_SRC_SYNTHESIS     — kernel source file path
#   MM_TB_SYNTHESIS      — C++ test bench file path (the C-sim oracle)
#   MM_SYNTHESIS_FLAGS   — -O3 plus -I paths for include directories
#   MM_TARGET_CLOCK_TCL  — target clock frequency in MHz

open_component -reset @MM_COSIM_COMPONENT@ -flow_target vivado

@MM_BOARD_OPTION@

add_files     -cflags "@MM_SYNTHESIS_FLAGS@" "@MM_SRC_SYNTHESIS@"
# -DMATMUL_COSIM selects TestMatmulSim.cpp's fixed-buffer path (the cosim
# contract needs each m_axi pointer backed by a MATMUL_COSIM_DEPTH_*-sized
# allocation).  Applied to the test bench only — the kernel must not see it.
add_files -tb -cflags "@MM_SYNTHESIS_FLAGS@ -DMATMUL_COSIM" "@MM_TB_SYNTHESIS@"
set_top MatmulKernel

create_clock -period @MM_TARGET_CLOCK_TCL@MHz -name default

config_interface -m_axi_addr64
config_interface -m_axi_max_widen_bitwidth @AXI_BUS_WIDTH@
config_rtl -reset_level low

# Step 1 — C synthesis.  Step 2 — RTL co-simulation against the C testbench.
# Both steps run in this one invocation, so the component carries synthesis
# AND cosim reports.
csynth_design
cosim_design

exit
