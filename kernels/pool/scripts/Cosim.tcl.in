# Vitis HLS synthesis + C/RTL co-simulation script for PoolingKernel.
# Generated by CMake.
#
# Runs C synthesis and RTL co-simulation in a SINGLE component run, so the
# component's run summary (open with `vitis -a <component>`) covers BOTH the
# synthesis report and the cosim report — measured latency / II plus the
# actual hls::stream FIFO channel depths from -enable_dataflow_profiling.
#
# Sequencing multiple HLS steps needs no special mechanism: listing
# csynth_design then cosim_design in one TCL and running it with a single
# `vitis-run --mode hls --tcl` invocation executes them in order on the same
# component (matches Xilinx's run_vitis_unified.tcl example).
#
# Variables substituted by CMake configure_file (@ONLY):
#   POOL_COSIM_COMPONENT  — HLS component directory name
#   POOL_BOARD_OPTION     — set_part command (includes -board if present)
#   POOL_SRC_SYNTHESIS    — kernel source file path
#   POOL_TB_SYNTHESIS     — C++ test bench file path (the C-sim oracle)
#   POOL_SYNTHESIS_FLAGS  — -O3 plus -I paths for include directories
#   POOL_TARGET_CLOCK_TCL — target clock frequency in MHz

open_component -reset @POOL_COSIM_COMPONENT@ -flow_target vivado

@POOL_BOARD_OPTION@

add_files     -cflags "@POOL_SYNTHESIS_FLAGS@" "@POOL_SRC_SYNTHESIS@"
# -DPOOL_COSIM selects TestPoolingSim.cpp's fixed-buffer path (the cosim
# contract needs each m_axi pointer backed by a POOL_COSIM_DEPTH_*-sized
# allocation).  Applied to the test bench only — the kernel must not see
# this define.
add_files -tb -cflags "@POOL_SYNTHESIS_FLAGS@ -DPOOL_COSIM" "@POOL_TB_SYNTHESIS@"
set_top PoolingKernel

create_clock -period @POOL_TARGET_CLOCK_TCL@MHz -name default

config_interface -m_axi_addr64
config_interface -m_axi_max_widen_bitwidth @AXI_BUS_WIDTH@
config_rtl -reset_level low

# Step 1 — C synthesis.  Step 2 — RTL co-simulation against the C testbench.
# -enable_dataflow_profiling instruments the per-channel occupancy monitors.
# (-wave_debug would also capture the waveform database the Vitis Analyzer
# Dataflow Viewer's "Cosim Max Depth" column renders, but it makes cosim
# ~15x slower, so it is intentionally left off.)
# Both steps run in this one invocation, so the component carries synthesis
# AND cosim reports.
csynth_design
cosim_design -enable_dataflow_profiling

exit
