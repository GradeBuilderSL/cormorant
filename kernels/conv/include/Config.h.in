#pragma once

#include <cstdint>
@CONV_DATA_TYPE_INCLUDE@
@CONV_HAVE_APFIXED_DEFINE@

// ---------------------------------------------------------------------------
// Element and accumulator types — configured by CMake.
//
// Default (Vitis HLS available):
//   Data_t    = ap_fixed<16,8>   range [-128, 127.996], 1/256 LSB
//   AccData_t = ap_fixed<32,16>  range [-32768, 32767.999]
//
// Fallback (no Vitis HLS):
//   Data_t    = float
//   AccData_t = float           (no saturation; reference only)
//
// AccData_t overflow for ap_fixed<16,8> inputs:
//   worst-case product  ≈ 128^2 = 16384
//   ap_fixed<32,16> max ≈ 32767
//   safe for C×kH×kW ≤ 2 (worst case) / ≤ ~32768 (|values| ≤ 1 typical)
//   Use ap_fixed<40,24> via CONV_ACC_DATA_TYPE for deeper reductions.
// ---------------------------------------------------------------------------
using Data_t    = @CONV_DATA_TYPE@;
using AccData_t = @CONV_ACC_DATA_TYPE@;

// ---------------------------------------------------------------------------
// Tile-size constants — compile-time parameters for the HLS kernel.
//
// kTileM   Output channel tile.  Must be a power of two so that
//          ri & (kTileM-1) compiles to a bitwise AND for the II=1 lane
//          rotation, and so that the dependency distance for acc[m1] equals
//          kTileM ≥ MAC latency (~3 cycles for ap_fixed<16,8>).
//
// kTileIC  Input channel tile.  Power of two; sets the w_buf and patch
//          buffer depth in the IC dimension.
//
// kMaxKH   Compile-time upper bound on kernel height.
// kMaxKW   Compile-time upper bound on kernel width.
//          Models with kH > kMaxKH or kW > kMaxKW are rejected by the
//          inference scheduler at validation time.
// ---------------------------------------------------------------------------
static constexpr unsigned kTileM   = @CONV_TILE_M@;
static constexpr unsigned kTileIC  = @CONV_TILE_IC@;
static constexpr unsigned kMaxKH   = @CONV_MAX_KH@;
static constexpr unsigned kMaxKW   = @CONV_MAX_KW@;

// ---------------------------------------------------------------------------
// kMaxInCh / kMaxOutCh / kMaxInW / kMaxLineBufRows / kMaxAccPersistEntries
//
// Compile-time upper bounds for the on-chip buffers in the standard-conv
// path.  The Option-A IC-tiling design shrinks the per-channel buffers
// (line_buf, broadcast local_buf, w_buf) from kMaxInCh to kTileIC channels
// at the cost of keeping a persistent partial-output buffer of
// kMaxAccPersistEntries elements that survives across ic-tiles.
//
//   * line_buf   — sized kTileIC * kMaxLineBufRows * kMaxInW.  Per-channel
//                  circular row buffer that caches the kh-row sliding
//                  window for the CURRENT (chunk, ic-tile).  Within a
//                  chunk each input pixel is fetched from DDR exactly
//                  once per (ni, channel); at chunk transitions the
//                  (kh-1)-row overlap is re-fetched (duplicate read).
//   * bias_buf   — sized kMaxOutCh.  Entire bias is loaded once and
//                  replayed in (r,mt,m1) order.
//   * partial_outputs — sized kMaxAccPersistEntries (flat).  Holds one
//                  output CHUNK's chunk_oh_count*out_w*out_ch AccData_t
//                  accumulators that survive across ic-tiles within the
//                  chunk; initialised from bias at chunk start and
//                  drained to acc_stream at chunk end.  Chunking along
//                  the oh axis lets the kernel handle outputs larger
//                  than the buffer; see compute_oh_chunking() in
//                  ConvKernel.cpp for the strategy.
//
// Constraints (validated by the inference scheduler):
//   in_ch    <= kMaxInCh
//   out_ch   <= kMaxOutCh
//   in_w     <= kMaxInW
//   (kh-1)*dilation_h + 1 <= kMaxLineBufRows
//   out_w * out_ch <= kMaxAccPersistEntries   (one output row must fit)
//
// Note: the older "out_h * out_w * out_ch <= kMaxAccPersistEntries"
// constraint has been relaxed via oh-chunking.  When the full output
// exceeds the buffer, the kernel transparently splits the oh axis into
// chunks of oh_per_chunk = floor(kMaxAccPersistEntries / (out_w*out_ch))
// rows, accepting duplicated input/weight reads at chunk boundaries.
//
// kMaxLineBufRows must be a power of 2 (bitmask is used in place of modulo).
// ---------------------------------------------------------------------------
static constexpr unsigned kMaxInCh             = @CONV_MAX_IN_CH@;
static constexpr unsigned kMaxOutCh            = @CONV_MAX_OUT_CH@;
static constexpr unsigned kMaxInW              = @CONV_MAX_IN_W@;
static constexpr unsigned kMaxLineBufRows      = @CONV_MAX_LINE_BUF_ROWS@;
static constexpr unsigned kMaxAccPersistEntries = @CONV_MAX_ACC_PERSIST_ENTRIES@;

static_assert(
    (kMaxLineBufRows & (kMaxLineBufRows - 1)) == 0,
    "kMaxLineBufRows must be a power of 2 (it is used as a bitmask)"
);

static constexpr unsigned kSeed    = 42;
